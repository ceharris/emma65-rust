{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "cargo: build adapter",
      "type": "shell",
      "command": "cargo build -p emma65-vscode-adapter",
      "options": {
        "cwd": "${workspaceFolder}/../.."
      },
      "problemMatcher": "$rustc",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "build",
      "dependsOn": [
        "npm: compile",
        "cargo: build adapter"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "webview: dev server",
      "type": "npm",
      "script": "webview:dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*ready in.*"
        }
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "build (trace webview dev server)",
      "dependsOn": [
        "npm: compile",
        "cargo: build adapter",
        "webview: dev server"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
