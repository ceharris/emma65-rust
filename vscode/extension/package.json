{
  "name": "emma65-vscode",
  "displayName": "emma65",
  "description": "VS Code integration for the emma65 6502 emulator/debugger (spike)",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:emma65.openTerminal",
    "onCommand:emma65.triggerNmi",
    "onCommand:emma65.assertIrq",
    "onCommand:emma65.releaseIrq",
    "onCommand:emma65.showBusState"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emma65.openTerminal",
        "title": "emma65: Open Console Terminal"
      },
      {
        "command": "emma65.triggerNmi",
        "title": "emma65: Trigger NMI",
        "icon": "$(zap)"
      },
      {
        "command": "emma65.assertIrq",
        "title": "emma65: Assert IRQ",
        "icon": "$(arrow-up)"
      },
      {
        "command": "emma65.releaseIrq",
        "title": "emma65: Release IRQ",
        "icon": "$(arrow-down)"
      },
      {
        "command": "emma65.showBusState",
        "title": "emma65: Show Bus/Interrupt State",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "emma65.triggerNmi",
          "when": "debugType == 'emma65'"
        },
        {
          "command": "emma65.assertIrq",
          "when": "debugType == 'emma65'"
        },
        {
          "command": "emma65.releaseIrq",
          "when": "debugType == 'emma65'"
        },
        {
          "command": "emma65.showBusState",
          "when": "debugType == 'emma65'"
        }
      ]
    },
    "debuggers": [
      {
        "type": "emma65",
        "label": "emma65",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "configPath": {
                "type": "string",
                "description": "Path to an emma65 emulator.toml config file. Falls back to the built-in default device layout (32K RAM, embedded TaliForth ROM, VIA, PTM, two ACIAs, LFSR, console) when omitted."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "emma65",
            "request": "launch",
            "name": "Launch emma65"
          }
        ],
        "configurationSnippets": [
          {
            "label": "emma65: Launch",
            "description": "Launch the emma65 emulator under the debugger",
            "body": {
              "type": "emma65",
              "request": "launch",
              "name": "Launch emma65"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.2.0"
  }
}
