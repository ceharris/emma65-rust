{
  "productName": "emma65-debugger",
  "version": "0.1.0",
  "identifier": "org.emma65.debugger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emma65 Debugger",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "terminal-detached",
        "title": "Emma65 Terminal",
        "url": "terminal-detached.html",
        "width": 860,
        "height": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "display-detached",
        "title": "Emma65 Display",
        "url": "display-detached.html",
        "width": 640,
        "height": 400,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "led-matrix-detached",
        "title": "Emma65 LED Matrix",
        "url": "led-matrix-detached.html",
        "width": 700,
        "height": 300,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "lcd-display-detached",
        "title": "Emma65 LCD Display",
        "url": "lcd-display-detached.html",
        "width": 480,
        "height": 240,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
