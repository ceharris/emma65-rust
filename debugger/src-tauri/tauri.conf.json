{
  "productName": "emma65-debugger",
  "version": "0.1.0",
  "identifier": "org.emma65.debugger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emma65 Debugger",
        "width": 1600,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "terminal",
        "title": "Emma65 Terminal",
        "url": "terminal.html",
        "width": 860,
        "height": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "trace",
        "title": "Emma65 Trace",
        "url": "trace.html",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "log",
        "title": "Emma65 Log",
        "url": "log.html",
        "width": 1000,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "dockview-spike",
        "title": "Dockview Spike (Phase 0, issue #379)",
        "url": "spike.html",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "stack-detached-static",
        "title": "Stack (detached spike, static A/B)",
        "url": "stack-detached.html",
        "width": 300,
        "height": 420,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
