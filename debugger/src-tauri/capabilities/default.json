{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for all debugger windows",
  "windows": ["main", "terminal", "trace"],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text"
  ]
}